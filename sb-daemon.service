[Unit]
Description=SteadyBearing fan control daemon
After=multi-user.target

[Service]
Type=simple
Group=sb
StateDirectory=sb
StateDirectoryMode=0750
RuntimeDirectory=sb
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/sb-daemon -v
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
